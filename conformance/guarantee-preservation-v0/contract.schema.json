{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prf:experimental:guarantee-preservation-v0",
  "title": "Experimental guarantee preservation envelope v0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "guarantee-preservation-v0"
    },
    "adapter_ref": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_ref": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "guarantee_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "semantics": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "semantics"
          ],
          "additionalProperties": false
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "guarantee_id",
        "subject",
        "scope",
        "assumptions",
        "authority",
        "version"
      ],
      "additionalProperties": false
    },
    "depends_on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependency_basis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "additionalProperties": false
    },
    "evidence_class": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "ref",
          "kind",
          "payload",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "native": {
      "type": "object",
      "properties": {
        "output": {
          "type": "object"
        },
        "verdict": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "present",
            "value"
          ],
          "additionalProperties": false
        },
        "evidence_grade": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "present",
            "value"
          ],
          "additionalProperties": false
        },
        "signature_predicate": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "scan_assertion": {
          "enum": [
            "UNKNOWN",
            "NATIVE_SCOPED"
          ]
        }
      },
      "required": [
        "output",
        "verdict",
        "reason",
        "evidence_grade"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "evaluator_ref": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "establishes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "does_not_establish": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "dependency_id",
          "evaluator_ref",
          "outcome",
          "evidence_refs",
          "establishes",
          "does_not_establish"
        ],
        "additionalProperties": false
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "adapter_ref",
    "evaluator_ref",
    "context",
    "depends_on",
    "depends_on_digest",
    "dependency_basis",
    "evidence_class",
    "evidence",
    "native",
    "checks",
    "does_not_establish"
  ],
  "additionalProperties": false
}
