{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pipavlo82/protected-relation-fixtures/adapters/v0/response-schema.json",
  "title": "Protected Relation Fixtures external adapter response v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter_status",
    "request_digest",
    "challenge_id",
    "challenge_digest",
    "protected_relation_profile_digest",
    "evaluator",
    "evaluator_output_digest",
    "invocation_digest",
    "outcome",
    "reason_code",
    "reason_detail",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "protected-relation-external-adapter-response.v0"
    },
    "adapter_status": {
      "const": "RESPONSE_VALID"
    },
    "request_digest": {
      "$ref": "#/$defs/sha256"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^prf-[0-9]{3}$"
    },
    "challenge_digest": {
      "$ref": "#/$defs/sha256"
    },
    "protected_relation_profile_digest": {
      "$ref": "#/$defs/sha256"
    },
    "evaluator": {
      "$ref": "#/$defs/evaluator"
    },
    "evaluator_output_digest": {
      "$ref": "#/$defs/sha256"
    },
    "invocation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "outcome": {
      "enum": ["PRESERVED", "VIOLATED", "UNVERIFIABLE"]
    },
    "reason_code": {
      "const": "EVALUATOR_JUDGMENT"
    },
    "reason_detail": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "config_digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
